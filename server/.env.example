# Copy to .env for local dev, or to .env.prod for docker-compose.prod.yml.
# NEVER commit the populated file; .env is git-ignored.

# --- Core ---
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_generate_with_openssl_rand_base64_48
CLIENT_URL=http://localhost:3000

# --- Email (required) ---
# Mailtrap for dev; Postmark/SES/Sendgrid for prod.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM="ElectroMarket <noreply@electromarket.dev>"

# --- AWS S3 (required for image/avatar/ID uploads) ---
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# IAM policy must allow PutObject/DeleteObject on listings/*, avatars/*,
# id-documents/*. Bucket public-read for listings/* and avatars/* only;
# id-documents/* stays private (admin reads via short-lived signed URLs).

# --- Stripe Connect (Standard) — platform keys, shared across all sellers ---
# STRIPE_SECRET_KEY signs calls on behalf of each connected account via the
# Stripe-Account header. Sellers onboard via /account/payments → Stripe
# AccountLink; funds settle directly to their bank. STRIPE_WEBHOOK_SECRET
# is the Connect webhook signing secret (one per endpoint).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Square — OAuth app credentials, per-seller tokens ---
# SQUARE_APPLICATION_ID + SQUARE_APPLICATION_SECRET from Developer Dashboard
# → OAuth. Replaces the old SQUARE_ACCESS_TOKEN (which was a platform-level
# personal token). Each seller authorizes our app and we store their token
# encrypted in SellerPaymentAccount.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENV=sandbox
# HMAC key used to sign the OAuth state param (prevents CSRF account
# linking). Generate with: openssl rand -hex 32
SQUARE_OAUTH_STATE_SECRET=
# Webhook signing key + subscribed URL — still used for legacy Square
# platform webhooks (receiving payment.updated for in-flight orders that
# predate the connected-accounts migration). New orders don't rely on these.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# --- Platform fee (optional) ---
# ElectroMarket runs fee-free by default — sellers receive 100% of each
# payment direct to their Stripe / Square account. To opt in to a platform
# fee on Stripe payments later, set basis points here (500 = 5%, 250 = 2.5%).
# Range enforced: 0–2000 (0%–20%). Square has no native platform-fee
# primitive, so any value here only affects Stripe charges.
# PLATFORM_FEE_BPS=0

# --- Support reply From address ---
# What the customer sees as the From: when an admin replies via /admin/contact.
# Use a real address (support@<your-domain>) so when they hit Reply, the
# message routes through your inbound provider to /api/webhooks/email.
# Defaults to EMAIL_FROM if unset.
SUPPORT_EMAIL_FROM=ElectroMarket Support <support@electromarket-app.com>

# --- Inbound email webhook ---
# Shared secret your inbound provider (Resend Inbound, Mailgun Parse,
# Cloudflare Worker, etc.) sends as the X-Email-Secret header on POST
# /api/webhooks/email. Generate with: openssl rand -hex 32
EMAIL_WEBHOOK_SECRET=

# --- At-rest encryption key for seller OAuth tokens ---
# Encrypts Square access_token + refresh_token in the SellerPaymentAccount
# table. 32 raw bytes as 64 hex chars. Generate with: openssl rand -hex 32
# ROTATING THIS INVALIDATES ALL STORED TOKENS — every connected seller will
# need to reconnect. Treat like JWT_SECRET.
PAYMENT_TOKEN_ENCRYPTION_KEY=

# --- Phone verification (Firebase Phone Auth) ---
# Firebase handles the SMS send + reCAPTCHA + OTP entry on the client; this
# server-side credential is used solely to verify the resulting ID token via
# the firebase-admin SDK. Generate by:
#   Firebase Console → Project Settings → Service accounts →
#   Generate new private key (downloads JSON).
# Encode that JSON as base64 (single-line) and paste below — Railway/Vercel
# env-var UIs mangle the newlines in the raw private_key field, base64
# sidesteps it. Generate with:  base64 -w 0 service-account.json
# Treat this exactly like a database password.
FIREBASE_SERVICE_ACCOUNT=

# --- Cloudflare Turnstile (bot defense on /register) ---
# Sitekey is exposed to the browser (public); secret stays server-side.
# Get both at dash.cloudflare.com → Turnstile. When TURNSTILE_SECRET_KEY is
# unset the /register endpoint skips verification (dev convenience — the
# widget uses the always-pass test sitekey 1x00000000000000000000AA).
TURNSTILE_SECRET_KEY=
# Client-side sitekey. Also exposed via client/.env as NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SITE_KEY=

# --- Dev escape hatches (NEVER set in production) ---
# When =1, email verification URLs are logged to stdout and returned in
# register/resend responses so you can click through without SMTP.
# ENABLE_DEV_EMAIL=1
