# Copy to .env for local dev, or to .env.prod for docker-compose.prod.yml.
# NEVER commit the populated file; .env is git-ignored.

# --- Core ---
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_generate_with_openssl_rand_base64_48
CLIENT_URL=http://localhost:3000

# --- Email (required) ---
# Mailtrap for dev; Postmark/SES/Sendgrid for prod.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM="ElectroMarket <noreply@electromarket.dev>"

# --- AWS S3 (required for image/avatar/ID uploads) ---
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# IAM policy must allow PutObject/DeleteObject on listings/*, avatars/*,
# id-documents/*. Bucket public-read for listings/* and avatars/* only;
# id-documents/* stays private (admin reads via short-lived signed URLs).

# --- Stripe (optional; /pay STRIPE returns 503 if unset) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Square (optional; /pay SQUARE returns 503 if unset) ---
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# --- PayPal (optional; /pay PAYPAL returns 503 if unset) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- Dev escape hatches (NEVER set in production) ---
# When =1, email verification URLs are logged to stdout and returned in
# register/resend responses so you can click through without SMTP.
# ENABLE_DEV_EMAIL=1
# When =1, /verify-phone returns the 6-digit OTP in the response body
# so you can exercise phone verification without a Twilio account.
# ENABLE_DEV_OTP=1
