generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Condition {
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  ACTIVE
  ON_HOLD
  SOLD
  REMOVED
}

enum OrderStatus {
  PENDING_CONFIRMATION // buyer checked out, waiting for seller to confirm
  CONFIRMED            // seller confirmed, item on hold, awaiting payment
  PAID                 // payment captured (online) or marked paid (cash/bank); listing now SOLD; awaiting shipment
  SHIPPED              // seller marked posted; in transit to buyer
  COMPLETED            // buyer confirmed received; deal finished
  CANCELLED            // either party cancelled
  REFUNDED             // seller refunded the buyer post-payment (item returned, dispute outcome, etc.)
}

enum PaymentMethod {
  CASH          // cash on meetup/pickup
  BANK_TRANSFER // direct bank transfer
  PAYPAL        // PayPal (all sellers)
  SQUARE        // Square — business sellers only
  STRIPE        // Stripe — business sellers only
}

// Tracks an online payment session in flight, independent of the order's
// lifecycle status. `/pay` flips NONE → PENDING; webhooks / capture flip
// PENDING → COMPLETED. Cancel is refused while PENDING so the buyer can't
// cancel mid-charge and strand money at the provider.
enum PaymentSessionState {
  NONE
  PENDING
  COMPLETED
}

enum SellerType {
  PERSONAL
  BUSINESS
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

enum NotificationType {
  ORDER_PLACED       // seller: buyer checked out
  ORDER_CONFIRMED    // buyer: seller accepted
  ORDER_CANCELLED    // other party: cancelled
  ORDER_COMPLETED    // both: order fully complete (buyer received)
  ORDER_PAID         // seller: payment captured / marked paid
  ORDER_SHIPPED      // buyer: seller marked the item as posted
  ORDER_REFUNDED     // buyer: seller issued a refund
  ORDER_DISPUTED     // seller + admin: buyer opened a dispute
  DISPUTE_RESOLVED   // buyer + seller: admin closed a dispute
  NEW_MESSAGE        // receiver: counterparty sent a message on an order thread
  NEW_INQUIRY        // seller: buyer opened a pre-purchase inquiry
  NEW_INQUIRY_REPLY  // either: counterparty replied on an inquiry thread
  NEW_REVIEW         // seller: buyer left a review
  ID_APPROVED        // user: admin approved ID
  ID_REJECTED        // user: admin rejected ID
}

enum DisputeStatus {
  OPEN              // buyer just filed; awaiting admin / seller action
  RESOLVED_REFUND   // admin marked resolved with refund (informational; refund itself happens via the refund endpoint)
  RESOLVED_NO_REFUND // admin marked resolved without refund (seller's position upheld)
  WITHDRAWN         // buyer withdrew the dispute
}

enum DisputeReason {
  NOT_RECEIVED       // item never arrived
  NOT_AS_DESCRIBED   // received but condition / model / spec doesn't match listing
  DAMAGED            // arrived broken
  OTHER              // free-text in `description`
}

enum ContactStatus {
  NEW       // arrived, no admin action (or customer just replied on a previously-replied thread)
  REPLIED   // at least one admin reply sent and waiting on customer
  CLOSED    // admin marked done; no more replies expected
}

enum ContactReplyDirection {
  OUTBOUND  // admin → customer, sent via sendAdminContactReply
  INBOUND   // customer → admin, received via /api/webhooks/email
}

// Audience preset for a broadcast. KEEP IN SYNC with resolveAudience() in
// services/broadcasts.ts — adding a value here without a server-side handler
// will silently send to nobody.
enum BroadcastAudience {
  ALL_VERIFIED          // every user with emailVerified=true
  ALL_SELLERS           // anyone marked as a seller
  BUSINESS_SELLERS      // sellerType=BUSINESS only
  PERSONAL_SELLERS      // sellerType=PERSONAL only
  SELLERS_NO_PAYMENT    // sellers with zero ACTIVE SellerPaymentAccount rows
  CUSTOM_EMAILS         // explicit list in Broadcast.targetEmails
}

enum InquiryStatus {
  OPEN    // active conversation
  CLOSED  // either party manually archived (still readable, just hidden by default)
}

enum PaymentProvider {
  STRIPE
  SQUARE
  PAYPAL
}

// Lifecycle of a seller's connected payment account.
//  PENDING      — seller clicked "Connect", provider redirected us back, but
//                 KYC/charges aren't yet usable. Buttons stay hidden.
//  ACTIVE       — fully onboarded, charges+payouts enabled.
//  RESTRICTED   — provider paused the account (KYC issue, dispute rate, etc.).
//                 We stop offering it for new orders; existing in-flight
//                 captures still run.
//  DISCONNECTED — token revoked by seller at the provider, or we detected an
//                 auth failure and disabled. Needs re-onboarding.
enum SellerAccountStatus {
  PENDING
  ACTIVE
  RESTRICTED
  DISCONNECTED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique @db.VarChar(255)
  username       String   @unique @db.VarChar(50)
  password       String   @db.VarChar(100) // bcrypt hash is fixed-length 60
  name           String   @db.VarChar(100)
  role           UserRole @default(USER)
  location       String?  @db.VarChar(100)
  bio            String?  @db.VarChar(500)
  phone          String?  @db.VarChar(20)
  // Public profile picture. S3 URL under avatars/<userId>/. Public-read
  // (same policy as listings/*). Null = render initial-letter fallback.
  avatarUrl      String?  @db.VarChar(500)
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?   @unique @db.VarChar(128)
  emailVerificationExpires DateTime?
  // Password-reset token: random 32-byte hex (64 chars), short 1h expiry.
  // Cleared on successful use, and tokenVersion is bumped so any JWTs issued
  // before the reset (including attacker-held ones) stop authenticating.
  passwordResetToken       String?   @unique @db.VarChar(128)
  passwordResetExpires     DateTime?
  // Two-phase email change: the new address sits here until the user clicks
  // the verification link sent to it. On verify, email ← pendingEmail and
  // pendingEmail is cleared. Keeps the old inbox live until the new one is
  // proven controlled by the same person (blocks session-steal lockout).
  pendingEmail             String?  @db.VarChar(255)
  phoneVerified           Boolean   @default(false)
  phoneVerificationCode     String?   @db.VarChar(100) // bcrypt hash of 6-digit OTP
  phoneVerificationExpires  DateTime?
  phoneVerificationAttempts Int       @default(0)
  sellerType     SellerType @default(PERSONAL)
  businessName   String?    @db.VarChar(100) // only for BUSINESS sellers
  abn            String?    @db.VarChar(11)  // Australian Business Number — 11 digits
  abnVerified    Boolean    @default(false)
  idDocumentUrl     String? @db.VarChar(500) // S3 URL — PERSONAL sellers only, front of ID
  idDocumentBackUrl String? @db.VarChar(500) // S3 URL — PERSONAL sellers only, back of ID
  idVerification VerificationStatus @default(NOT_SUBMITTED)
  idSubmittedAt  DateTime? // set when user POSTs /verify-id; admin queue orders by this (not updatedAt, which is bumped by unrelated profile edits)
  idRejectionReason String? @db.VarChar(500) // set when admin rejects; cleared on re-submit
  // Bumped on password change / logout-everywhere so JWTs issued before the
  // bump fail authentication. Added via `db push` in Day 19 — migration
  // history cleanup is a Day 21 item.
  tokenVersion   Int        @default(0)
  // Soft-delete marker. When set, the user can no longer log in or act,
  // their PII has been anonymized, and `/api/users/:id` 404s. The row stays
  // so foreign keys from orders / reviews / messages remain valid for the
  // counterparties.
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listings      Listing[]
  purchases     Order[]        @relation("buyer")
  sales         Order[]        @relation("seller")
  reviews       Review[]       @relation("reviewer")
  reviewsAbout  Review[]       @relation("reviewedSeller")
  savedListings SavedListing[]
  cart          Cart?
  sentMessages     Message[] @relation("sender")
  receivedMessages Message[] @relation("receiver")
  buyerInquiries  Inquiry[]        @relation("inquiryBuyer")
  sellerInquiries Inquiry[]        @relation("inquirySeller")
  sentInquiryMessages     InquiryMessage[] @relation("inquiryMessageSender")
  receivedInquiryMessages InquiryMessage[] @relation("inquiryMessageReceiver")
  notifications Notification[] @relation("recipient")
  triggeredNotifications Notification[] @relation("actor")
  paymentAccounts SellerPaymentAccount[]
  buyerDisputes  Dispute[] @relation("disputeBuyer")
  sellerDisputes Dispute[] @relation("disputeSeller")
  resolvedDisputes Dispute[] @relation("disputeResolver")
  contactReplies ContactReply[]    @relation("contactReplyAdmin")
  closedContacts ContactSubmission[] @relation("contactClosedBy")
  sentBroadcasts Broadcast[]       @relation("broadcastSender")

  @@index([deletedAt])
}

model Listing {
  id          String        @id @default(uuid())
  title       String        @db.VarChar(200)
  description String        @db.VarChar(5000)
  price       Decimal       @db.Decimal(10, 2)
  category    String        @db.VarChar(50)
  subcategory String?       @db.VarChar(50)
  platform    String?       @db.VarChar(50)
  brand       String?       @db.VarChar(50)
  condition   Condition
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller   User   @relation(fields: [sellerId], references: [id])
  sellerId String

  images        ListingImage[]
  orders        Order[]
  savedByUsers  SavedListing[]
  cartItems     CartItem[]
  inquiries     Inquiry[]

  @@index([status, createdAt])
  @@index([status, category])
  @@index([status, price])
  @@index([sellerId])
}

model ListingImage {
  id           String  @id @default(uuid())
  url          String  @db.VarChar(500)
  displayOrder Int

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@unique([listingId, displayOrder])
}

model Cart {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  @@unique([cartId, listingId])
}

model Order {
  id            String        @id @default(uuid())
  amount        Decimal       @db.Decimal(10, 2)
  status        OrderStatus   @default(PENDING_CONFIRMATION)
  paymentMethod PaymentMethod?
  // Online-payment session tracking. Independent of `status`. Gates cancel
  // during a live charge. Manual completions (CASH/BANK_TRANSFER) leave this
  // at NONE and jump straight from status=CONFIRMED to status=COMPLETED.
  paymentSessionState PaymentSessionState @default(NONE)
  // Fulfillment timestamps (nullable; set when seller/buyer click the
  // corresponding action). Used to render "Awaiting shipment" / "In transit"
  // / "Received on …" badges and for the dashboard in-progress filter.
  trackingNumber String?   @db.VarChar(100)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  // Provider-side payment identifier captured at PAID time, used for refunds.
  //  - Stripe: payment_intent id (pi_...)
  //  - Square: payment id (the tender behind the Order)
  //  - cash/bank: null (no provider call possible)
  paymentProviderId String? @db.VarChar(200)
  // Refund metadata. refundedAt is set when status flips to REFUNDED;
  // refundReason is the seller's free-text justification (shown to buyer).
  // refundProviderId is the Stripe refund_id / Square refund_id for audit
  // — null for cash/bank where no provider was involved.
  refundedAt       DateTime?
  refundReason     String?  @db.VarChar(500)
  refundProviderId String?  @db.VarChar(200)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  buyer   User   @relation("buyer", fields: [buyerId], references: [id])
  buyerId String

  seller   User   @relation("seller", fields: [sellerId], references: [id])
  sellerId String

  review   Review?
  messages Message[]
  dispute  Dispute?

  @@index([sellerId, createdAt])
  @@index([buyerId, createdAt])
  @@index([listingId])
  // Used by the admin "stuck payments" view: PENDING sessions older than N min.
  @@index([paymentSessionState, updatedAt])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?  @db.VarChar(2000)
  createdAt DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique

  reviewer   User   @relation("reviewer", fields: [reviewerId], references: [id])
  reviewerId String

  seller   User   @relation("reviewedSeller", fields: [sellerId], references: [id])
  sellerId String

  @@index([sellerId])
}

model SavedListing {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    String

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@unique([userId, listingId])
}

model Message {
  id        String    @id @default(uuid())
  content   String    @db.VarChar(2000)
  createdAt DateTime  @default(now())
  // Set when the receiver fetches the thread. Lets the inbox show unread
  // counts per thread + the Navbar envelope badge sum.
  readAt    DateTime?

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  sender   User   @relation("sender", fields: [senderId], references: [id])
  senderId String

  receiver   User   @relation("receiver", fields: [receiverId], references: [id])
  receiverId String

  @@index([orderId, createdAt])
  // Backs GET /api/inbox/unread-count: "unread messages to me".
  @@index([receiverId, readAt])
}

// User-facing inbox item. One row per event the user should know about
// (order state changes, new messages, reviews, admin verification).
// `readAt` = null means unread (shows in the Navbar bell badge).
// `actor` is the user who triggered the event (counterparty / admin) —
// nullable so system-initiated events can still emit notifications.
model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String           @db.VarChar(200) // short summary rendered in the UI
  body      String           @db.VarChar(500) // detail line under the title
  readAt    DateTime?
  createdAt DateTime         @default(now())

  recipient   User   @relation("recipient", fields: [recipientId], references: [id])
  recipientId String

  actor   User?   @relation("actor", fields: [actorId], references: [id])
  actorId String?

  // Optional denormalized references. The UI uses these to build click
  // targets (e.g., `/dashboard?tab=sales&order=<id>`). Strings — not FKs —
  // so a notification survives the referenced row being deleted.
  orderId    String?
  listingId  String?

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

// Replay-dedupe for webhook events. Unique (provider, eventId) is the
// deduplication key; orderId is stored for audit/debug only. No FK on orderId
// so the audit trail survives even if an order row were ever removed.
model ProcessedWebhookEvent {
  id        String   @id @default(uuid())
  provider  String   @db.VarChar(20)
  eventId   String   @db.VarChar(100)
  orderId   String?
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
}

// Pre-purchase inquiry — a private 1:1 conversation between a prospective
// buyer and the listing's seller. Distinct from order-level Message threads
// (which only exist after a purchase request). One inquiry per listing per
// buyer; subsequent questions reuse the same thread.
model Inquiry {
  id            String        @id @default(uuid())
  status        InquiryStatus @default(OPEN)
  // Bumped whenever a message is added; powers inbox sort + unread badge.
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  buyer   User   @relation("inquiryBuyer", fields: [buyerId], references: [id])
  buyerId String

  seller   User   @relation("inquirySeller", fields: [sellerId], references: [id])
  sellerId String

  messages InquiryMessage[]

  // Reuse-or-create lookup: a buyer asking again on the same listing should
  // land in their existing thread, not spawn a new one.
  @@unique([listingId, buyerId])
  @@index([sellerId, lastMessageAt])
  @@index([buyerId, lastMessageAt])
}

model InquiryMessage {
  id        String    @id @default(uuid())
  content   String    @db.VarChar(2000)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  inquiryId String

  sender   User   @relation("inquiryMessageSender", fields: [senderId], references: [id])
  senderId String

  receiver   User   @relation("inquiryMessageReceiver", fields: [receiverId], references: [id])
  receiverId String

  @@index([inquiryId, createdAt])
  // Backs unread-count: "unread inquiry messages to me".
  @@index([receiverId, readAt])
}

// Buyer-initiated dispute on a paid order. One per order (unique on orderId)
// — re-disputing means the buyer reopens via messaging, not a second row.
// Notifying admin on creation lets us mediate; resolution is admin-only via
// the admin disputes queue.
model Dispute {
  id          String         @id @default(uuid())
  status      DisputeStatus  @default(OPEN)
  reason      DisputeReason
  description String         @db.VarChar(2000)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?
  // Free-text resolution note from the admin (visible to buyer + seller).
  resolutionNote String?     @db.VarChar(2000)

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique

  buyer   User   @relation("disputeBuyer", fields: [buyerId], references: [id])
  buyerId String

  seller   User   @relation("disputeSeller", fields: [sellerId], references: [id])
  sellerId String

  // Set when an admin closes the dispute. Nullable — open disputes have no
  // resolver yet.
  resolvedBy   User?   @relation("disputeResolver", fields: [resolvedById], references: [id])
  resolvedById String?

  // Backs the admin queue ("show me OPEN disputes oldest-first").
  @@index([status, createdAt])
  @@index([sellerId])
}

// Inbound contact-form submission. Persisted so admins can reply from inside
// the app (instead of from their personal email) and so we have a history /
// re-contact log rather than relying on an inbox search. The original email
// notification still fires — this row is the canonical record.
model ContactSubmission {
  id        String        @id @default(uuid())
  fromName  String        @db.VarChar(100)
  fromEmail String        @db.VarChar(255)
  subject   String        @db.VarChar(150)
  message   String        @db.VarChar(3000)
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  closedAt    DateTime?
  closedBy    User?     @relation("contactClosedBy", fields: [closedById], references: [id])
  closedById  String?

  replies ContactReply[]

  // Inbox view: NEW first, then by createdAt desc.
  @@index([status, createdAt])
  // For the admin to look up submissions by a sender's email (e.g., when the
  // same person opens multiple tickets).
  @@index([fromEmail])
}

// One row per message on a contact thread — both directions. Admin replies
// have direction=OUTBOUND and adminId set. Customer replies (received via
// the inbound email webhook) have direction=INBOUND, adminId=null.
// Originally OUTBOUND-only ("ContactReply"); INBOUND added when we set up
// inbound email parsing so customers replying via Gmail land in /admin/contact
// instead of the admin's personal inbox.
model ContactReply {
  id        String                  @id @default(uuid())
  body      String                  @db.VarChar(10000)
  sentAt    DateTime                @default(now())
  direction ContactReplyDirection   @default(OUTBOUND)

  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  // Set on OUTBOUND only (admin who composed the reply). NULL on INBOUND.
  admin   User?  @relation("contactReplyAdmin", fields: [adminId], references: [id])
  adminId String?

  @@index([submissionId, sentAt])
}

// Admin-initiated broadcast (announcement to many users at once). Each row
// is one send event — re-running the same announcement creates a new row.
// audience + targetEmails define WHO; channelEmail / channelInApp define HOW;
// sentCount + failedCount + sentAt prove WHAT happened. Body stored so the
// admin can re-send the same content if needed.
model Broadcast {
  id              String           @id @default(uuid())
  subject         String           @db.VarChar(200)
  body            String           @db.VarChar(20000)
  audience        BroadcastAudience
  // Comma-separated list when audience=CUSTOM_EMAILS; null otherwise.
  targetEmails    String?          @db.VarChar(5000)
  channelEmail    Boolean          @default(true)
  channelInApp    Boolean          @default(true)
  // Snapshot of audience size at send time.
  audienceCount   Int
  sentCount       Int              @default(0)
  failedCount     Int              @default(0)
  status          String           @default("SENDING") @db.VarChar(20) // SENDING | DONE | FAILED
  createdAt       DateTime         @default(now())
  finishedAt      DateTime?

  sentBy   User   @relation("broadcastSender", fields: [sentById], references: [id])
  sentById String

  @@index([createdAt])
}

// A seller's linked payment provider account. Per-seller credentials replace
// the previous centralized platform keys — funds settle directly to the
// seller's bank/PayPal, so the platform is no longer in the funds flow.
//  - Stripe: `accountId` is `acct_...` from Stripe Connect Standard.
//    `accessToken` stays null (Stripe Connect uses the `Stripe-Account` header
//    with our platform secret key, not a per-seller token).
//  - PayPal: `accountId` is the merchant's `merchant_id` from Partner Referrals.
//    No token stored — we use our platform client credentials and pass the
//    merchant via `payee.merchant_id`.
//  - Square: `accessToken` + `refreshToken` are the seller's OAuth tokens
//    (encrypted at rest); `accountId` is the seller's Square merchant_id;
//    `locationId` is their default location.
// Unique (userId, provider) — re-onboarding updates the row in place so
// history (onboardedAt, status transitions) isn't lost.
model SellerPaymentAccount {
  id             String               @id @default(uuid())
  provider       PaymentProvider
  status         SellerAccountStatus  @default(PENDING)
  accountId      String               @db.VarChar(200)
  accessToken    String?              @db.VarChar(5000)
  refreshToken   String?              @db.VarChar(5000)
  tokenExpiresAt DateTime?
  scope          String?              @db.VarChar(500)
  locationId     String?              @db.VarChar(100)
  chargesEnabled Boolean              @default(false)
  payoutsEnabled Boolean              @default(false)
  onboardedAt    DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([userId, provider])
  @@index([provider, status])
}
