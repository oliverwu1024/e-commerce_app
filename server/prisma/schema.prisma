generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Condition {
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  ACTIVE
  ON_HOLD
  SOLD
  REMOVED
}

enum OrderStatus {
  PENDING_CONFIRMATION // buyer checked out, waiting for seller to confirm
  CONFIRMED            // seller confirmed, item on hold
  COMPLETED            // payment done (online or in-person), deal finished
  CANCELLED            // either party cancelled
}

enum PaymentMethod {
  ONLINE   // pay via Stripe
  IN_PERSON // cash on meetup/pickup
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  name      String
  location  String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings      Listing[]
  purchases     Order[]        @relation("buyer")
  sales         Order[]        @relation("seller")
  reviews       Review[]       @relation("reviewer")
  reviewsAbout  Review[]       @relation("reviewedSeller")
  savedListings SavedListing[]
  cart          Cart?
  sentMessages     Message[] @relation("sender")
  receivedMessages Message[] @relation("receiver")
}

model Listing {
  id          String        @id @default(uuid())
  title       String
  description String
  price       Float
  category    String
  subcategory String?
  platform    String?
  brand       String?
  condition   Condition
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller   User   @relation(fields: [sellerId], references: [id])
  sellerId String

  images        ListingImage[]
  orders        Order[]
  savedByUsers  SavedListing[]
  cartItems     CartItem[]
}

model ListingImage {
  id           String  @id @default(uuid())
  url          String
  displayOrder Int

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
}

model Cart {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  @@unique([cartId, listingId])
}

model Order {
  id            String        @id @default(uuid())
  amount        Float
  status        OrderStatus   @default(PENDING_CONFIRMATION)
  paymentMethod PaymentMethod?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  buyer   User   @relation("buyer", fields: [buyerId], references: [id])
  buyerId String

  seller   User   @relation("seller", fields: [sellerId], references: [id])
  sellerId String

  review   Review?
  messages Message[]
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique

  reviewer   User   @relation("reviewer", fields: [reviewerId], references: [id])
  reviewerId String

  seller   User   @relation("reviewedSeller", fields: [sellerId], references: [id])
  sellerId String
}

model SavedListing {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    String

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@unique([userId, listingId])
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  sender   User   @relation("sender", fields: [senderId], references: [id])
  senderId String

  receiver   User   @relation("receiver", fields: [receiverId], references: [id])
  receiverId String
}
