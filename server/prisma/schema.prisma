generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Condition {
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  ACTIVE
  ON_HOLD
  SOLD
  REMOVED
}

enum OrderStatus {
  PENDING_CONFIRMATION // buyer checked out, waiting for seller to confirm
  CONFIRMED            // seller confirmed, item on hold
  COMPLETED            // payment done (online or in-person), deal finished
  CANCELLED            // either party cancelled
}

enum PaymentMethod {
  CASH          // cash on meetup/pickup
  BANK_TRANSFER // direct bank transfer
  PAYPAL        // PayPal (all sellers)
  SQUARE        // Square — business sellers only
  STRIPE        // Stripe — business sellers only
}

enum SellerType {
  PERSONAL
  BUSINESS
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String   @unique
  password       String
  name           String
  role           UserRole @default(USER)
  location       String?
  bio            String?
  phone          String?
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?   @unique
  emailVerificationExpires DateTime?
  phoneVerified           Boolean   @default(false)
  sellerType     SellerType @default(PERSONAL)
  businessName   String?    // only for BUSINESS sellers
  abn            String?    // Australian Business Number — BUSINESS only
  abnVerified    Boolean    @default(false)
  idDocumentUrl  String?    // S3 URL — PERSONAL sellers only
  idVerification VerificationStatus @default(NOT_SUBMITTED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listings      Listing[]
  purchases     Order[]        @relation("buyer")
  sales         Order[]        @relation("seller")
  reviews       Review[]       @relation("reviewer")
  reviewsAbout  Review[]       @relation("reviewedSeller")
  savedListings SavedListing[]
  cart          Cart?
  sentMessages     Message[] @relation("sender")
  receivedMessages Message[] @relation("receiver")
}

model Listing {
  id          String        @id @default(uuid())
  title       String
  description String
  price       Decimal @db.Decimal(10, 2)
  category    String
  subcategory String?
  platform    String?
  brand       String?
  condition   Condition
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller   User   @relation(fields: [sellerId], references: [id])
  sellerId String

  images        ListingImage[]
  orders        Order[]
  savedByUsers  SavedListing[]
  cartItems     CartItem[]

  @@index([status, createdAt])
  @@index([status, category])
  @@index([status, price])
  @@index([sellerId])
}

model ListingImage {
  id           String  @id @default(uuid())
  url          String
  displayOrder Int

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@unique([listingId, displayOrder])
}

model Cart {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  @@unique([cartId, listingId])
}

model Order {
  id            String        @id @default(uuid())
  amount        Decimal @db.Decimal(10, 2)
  status        OrderStatus   @default(PENDING_CONFIRMATION)
  paymentMethod PaymentMethod?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  buyer   User   @relation("buyer", fields: [buyerId], references: [id])
  buyerId String

  seller   User   @relation("seller", fields: [sellerId], references: [id])
  sellerId String

  review   Review?
  messages Message[]
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique

  reviewer   User   @relation("reviewer", fields: [reviewerId], references: [id])
  reviewerId String

  seller   User   @relation("reviewedSeller", fields: [sellerId], references: [id])
  sellerId String

  @@index([sellerId])
}

model SavedListing {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    String

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@unique([userId, listingId])
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  sender   User   @relation("sender", fields: [senderId], references: [id])
  senderId String

  receiver   User   @relation("receiver", fields: [receiverId], references: [id])
  receiverId String
}
