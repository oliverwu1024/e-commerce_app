generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Condition {
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  ACTIVE
  ON_HOLD
  SOLD
  REMOVED
}

enum OrderStatus {
  PENDING_CONFIRMATION // buyer checked out, waiting for seller to confirm
  CONFIRMED            // seller confirmed, item on hold
  COMPLETED            // payment done (online or in-person), deal finished
  CANCELLED            // either party cancelled
}

enum PaymentMethod {
  CASH          // cash on meetup/pickup
  BANK_TRANSFER // direct bank transfer
  PAYPAL        // PayPal (all sellers)
  SQUARE        // Square — business sellers only
  STRIPE        // Stripe — business sellers only
}

// Tracks an online payment session in flight, independent of the order's
// lifecycle status. `/pay` flips NONE → PENDING; webhooks / capture flip
// PENDING → COMPLETED. Cancel is refused while PENDING so the buyer can't
// cancel mid-charge and strand money at the provider.
enum PaymentSessionState {
  NONE
  PENDING
  COMPLETED
}

enum SellerType {
  PERSONAL
  BUSINESS
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

enum NotificationType {
  ORDER_PLACED       // seller: buyer checked out
  ORDER_CONFIRMED    // buyer: seller accepted
  ORDER_CANCELLED    // other party: cancelled
  ORDER_COMPLETED    // buyer: seller marked paid / online capture landed
  ORDER_PAID         // seller: online payment captured
  NEW_MESSAGE        // receiver: counterparty sent a message
  NEW_REVIEW         // seller: buyer left a review
  ID_APPROVED        // user: admin approved ID
  ID_REJECTED        // user: admin rejected ID
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String   @unique
  password       String
  name           String
  role           UserRole @default(USER)
  location       String?
  bio            String?
  phone          String?
  // Public profile picture. S3 URL under avatars/<userId>/. Public-read
  // (same policy as listings/*). Null = render initial-letter fallback.
  avatarUrl      String?
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?   @unique
  emailVerificationExpires DateTime?
  // Two-phase email change: the new address sits here until the user clicks
  // the verification link sent to it. On verify, email ← pendingEmail and
  // pendingEmail is cleared. Keeps the old inbox live until the new one is
  // proven controlled by the same person (blocks session-steal lockout).
  pendingEmail             String?
  phoneVerified           Boolean   @default(false)
  phoneVerificationCode     String?   // bcrypt-hashed 6-digit OTP
  phoneVerificationExpires  DateTime?
  phoneVerificationAttempts Int       @default(0)
  sellerType     SellerType @default(PERSONAL)
  businessName   String?    // only for BUSINESS sellers
  abn            String?    // Australian Business Number — BUSINESS only
  abnVerified    Boolean    @default(false)
  idDocumentUrl  String?    // S3 URL — PERSONAL sellers only
  idVerification VerificationStatus @default(NOT_SUBMITTED)
  idSubmittedAt  DateTime? // set when user POSTs /verify-id; admin queue orders by this (not updatedAt, which is bumped by unrelated profile edits)
  idRejectionReason String? // set when admin rejects; cleared on re-submit
  // Bumped on password change / logout-everywhere so JWTs issued before the
  // bump fail authentication. Added via `db push` in Day 19 — migration
  // history cleanup is a Day 21 item.
  tokenVersion   Int        @default(0)
  // Soft-delete marker. When set, the user can no longer log in or act,
  // their PII has been anonymized, and `/api/users/:id` 404s. The row stays
  // so foreign keys from orders / reviews / messages remain valid for the
  // counterparties.
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listings      Listing[]
  purchases     Order[]        @relation("buyer")
  sales         Order[]        @relation("seller")
  reviews       Review[]       @relation("reviewer")
  reviewsAbout  Review[]       @relation("reviewedSeller")
  savedListings SavedListing[]
  cart          Cart?
  sentMessages     Message[] @relation("sender")
  receivedMessages Message[] @relation("receiver")
  notifications Notification[] @relation("recipient")
  triggeredNotifications Notification[] @relation("actor")

  @@index([deletedAt])
}

model Listing {
  id          String        @id @default(uuid())
  title       String
  description String
  price       Decimal @db.Decimal(10, 2)
  category    String
  subcategory String?
  platform    String?
  brand       String?
  condition   Condition
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller   User   @relation(fields: [sellerId], references: [id])
  sellerId String

  images        ListingImage[]
  orders        Order[]
  savedByUsers  SavedListing[]
  cartItems     CartItem[]

  @@index([status, createdAt])
  @@index([status, category])
  @@index([status, price])
  @@index([sellerId])
}

model ListingImage {
  id           String  @id @default(uuid())
  url          String
  displayOrder Int

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@unique([listingId, displayOrder])
}

model Cart {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  @@unique([cartId, listingId])
}

model Order {
  id            String        @id @default(uuid())
  amount        Decimal @db.Decimal(10, 2)
  status        OrderStatus   @default(PENDING_CONFIRMATION)
  paymentMethod PaymentMethod?
  // Online-payment session tracking. Independent of `status`. Gates cancel
  // during a live charge. Manual completions (CASH/BANK_TRANSFER) leave this
  // at NONE and jump straight from status=CONFIRMED to status=COMPLETED.
  paymentSessionState PaymentSessionState @default(NONE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String

  buyer   User   @relation("buyer", fields: [buyerId], references: [id])
  buyerId String

  seller   User   @relation("seller", fields: [sellerId], references: [id])
  sellerId String

  review   Review?
  messages Message[]

  @@index([sellerId, createdAt])
  @@index([buyerId, createdAt])
  @@index([listingId])
  // Used by the admin "stuck payments" view: PENDING sessions older than N min.
  @@index([paymentSessionState, updatedAt])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique

  reviewer   User   @relation("reviewer", fields: [reviewerId], references: [id])
  reviewerId String

  seller   User   @relation("reviewedSeller", fields: [sellerId], references: [id])
  sellerId String

  @@index([sellerId])
}

model SavedListing {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    String

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@unique([userId, listingId])
}

model Message {
  id        String    @id @default(uuid())
  content   String
  createdAt DateTime  @default(now())
  // Set when the receiver fetches the thread. Lets the inbox show unread
  // counts per thread + the Navbar envelope badge sum.
  readAt    DateTime?

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  sender   User   @relation("sender", fields: [senderId], references: [id])
  senderId String

  receiver   User   @relation("receiver", fields: [receiverId], references: [id])
  receiverId String

  @@index([orderId, createdAt])
  // Backs GET /api/inbox/unread-count: "unread messages to me".
  @@index([receiverId, readAt])
}

// User-facing inbox item. One row per event the user should know about
// (order state changes, new messages, reviews, admin verification).
// `readAt` = null means unread (shows in the Navbar bell badge).
// `actor` is the user who triggered the event (counterparty / admin) —
// nullable so system-initiated events can still emit notifications.
model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String           // short summary rendered in the UI
  body      String           // detail line under the title
  readAt    DateTime?
  createdAt DateTime         @default(now())

  recipient   User   @relation("recipient", fields: [recipientId], references: [id])
  recipientId String

  actor   User?   @relation("actor", fields: [actorId], references: [id])
  actorId String?

  // Optional denormalized references. The UI uses these to build click
  // targets (e.g., `/dashboard?tab=sales&order=<id>`). Strings — not FKs —
  // so a notification survives the referenced row being deleted.
  orderId    String?
  listingId  String?

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

// Replay-dedupe for webhook events. Unique (provider, eventId) is the
// deduplication key; orderId is stored for audit/debug only. No FK on orderId
// so the audit trail survives even if an order row were ever removed.
model ProcessedWebhookEvent {
  id        String   @id @default(uuid())
  provider  String
  eventId   String
  orderId   String?
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
}
